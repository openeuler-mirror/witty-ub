[Unit]
Description=Witty-UB Latency Plugin Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/witty-ub/latency
Environment=PYTHONPATH=/var/witty-ub
Environment=WITTY_DIR=/var/witty-ub
Environment=WITTY_REPORT_DIR=/var/witty-ub/reports
Environment=WITTY_CLASSIFIER_MODEL_DIR=/var/witty-ub/fault_classifier
Environment=WITTY_CASE_MATCHING_DIR=/var/witty-ub/classifier-runtime
EnvironmentFile=-/etc/witty-ub/classifier.env
ExecStart=/var/witty-ub/latency/deploy/run_backend.sh
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
