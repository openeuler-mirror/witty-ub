[Unit]
Description=Witty-UB Latency Plugin Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/witty-ub/latency
Environment=PYTHONPATH=/var/witty-ub
ExecStart=/var/witty-ub/latency/deploy/run_backend.sh
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
