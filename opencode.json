{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "witty_ub_diag_mcp": {
      "type": "local",
      "command": [
        "{env:WITTY_UB_LATENCY_PYTHON}",
        "-m",
        "latency.access.mcp_server"
      ],
      "environment": {
        "PYTHONPATH": "{env:WITTY_UB_PLUGINS_DIR}",
        "LATENCY_API_BASE_URL": "http://127.0.0.1:9772",
        "LATENCY_API_TIMEOUT_SECONDS": "30",
        "LATENCY_MCP_TRANSPORT": "stdio"
      },
      "enabled": true,
      "timeout": 10000
    }
  }
}
