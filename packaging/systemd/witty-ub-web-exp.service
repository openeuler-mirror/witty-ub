[Unit]
Description=witty-ub experimental web frontend (exp)
After=network.target

[Service]
Type=simple
RuntimeDirectory=witty-ub-web-exp
LogsDirectory=witty-ub-web-exp
ExecStartPre=/usr/sbin/nginx -t -c /etc/witty-ub/web-exp/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/witty-ub/web-exp/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/witty-ub/web-exp/nginx.conf -s reload
ExecStop=/usr/sbin/nginx -c /etc/witty-ub/web-exp/nginx.conf -s quit
KillMode=mixed
PrivateTmp=true

[Install]
WantedBy=multi-user.target
