{
    "log_filename_pattern": {
        "ds_client_access_log_file": [
            "ds_client_access*.log",
            "ds_client_access*.log.gz",
            "*_access.log"
        ],
        "ds_client_info_log_file": [
            "ds_client*.INFO.log",
            "ds_client*.INFO.log.gz",
            "*_runtime.log"
        ],
        "ds_worker_access_log_file": [
            "access.log",
            "access.log.gz",
            "*_access.log"
        ],
        "ds_worker_info_log_file": [
            "datasystem_worker.INFO*.log",
            "datasystem_worker.INFO*.log.gz",
            "kvcache.INFO*.log",
            "kvcache.INFO*.log.gz",
            "*_runtime.log"
        ],
        "resource_log_file": [
            "resource.log"
        ]
    },
    "log_analyzer_params": {
        "total_p99_threshold_ms": 2.0,
        "c2w_p99_threshold_ms": 2.0,
        "w2w_p99_threshold_ms": 1.5,
        "urma_link_p99_threshold_ms": 4.0,
        "query_meta_p99_threshold_ms": 1.0,
        "sliding_window_sizes": [100, 200, 300, 500],
        "sliding_window_steps": [20, 30, 40, 50],
        "zone_anomaly_density_threshold": 0.5
    }
}
