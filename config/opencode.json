{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "witty-ub-diagnostician": {
      "description": "Witty-UB diagnostician agent: 通过只读 HTTP API 分析 KVC 分布式缓存的时延和通断故障",
      "mode": "primary",
      "temperature": 0.25,
      "maxSteps": 15,
      "prompt": "{file:/var/witty-ub/config/agents/witty-ub-diagnostician.md}",
      "tools": {
        "*": false,
        "bash": true
      },
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "curl --silent --show-error --fail-with-body --max-time 30 --noproxy 127.0.0.1 http://127.0.0.1:9772/*": "allow"
        }
      }
    }
  }
}
